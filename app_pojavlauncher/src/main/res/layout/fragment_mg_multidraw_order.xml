<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="40dp">

        <include layout="@layout/include_mg_back_row" />

        <TextView
            android:id="@+id/mg_order_title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/primary_text" />

        <TextView
            android:id="@+id/mg_order_hint"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/md_order_hint"
            android:textColor="@color/secondary_text" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/mg_order_exception_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/md_exception_on"
            android:visibility="gone" />

        <View
            style="@style/ThickDivider"
            android:layout_width="match_parent"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mg_order_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mg_order_bench"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/md_bench_run_all" />

            <Button
                android:id="@+id/mg_order_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/md_reset_default" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
